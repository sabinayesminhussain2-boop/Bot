{
  "name": "veyora-restaurant-whatsapp-bot",
  "version": "1.0.0",
  "description": "Restaurant WhatsApp automation bot demo accessed via table QR codes (WhatsApp Business Platform Cloud API ready, with simulation mode)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "qr:generate": "tsx scripts/generate-qr.ts",
    "test": "npm run build && node --test dist/tests/flows.test.js"
  },
  "keywords": ["whatsapp", "chatbot", "restaurant", "automation"],
  "author": "VEYORA",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.0.5",
    "tsx": "^4.11.0",
    "typescript": "^5.5.4"
  }
}
