# VEYORA — Restaurant WhatsApp Bot configuration
# Copy this file to .env and fill in real values when connecting WhatsApp.
# Never commit .env to version control — it holds secrets.

# Server
PORT=3000

# Demo mode: "true" runs the bot entirely in simulation (no WhatsApp credentials needed).
# Set to "false" only after configuring real WhatsApp Business Platform credentials below.
DEMO_MODE=true

# --- WhatsApp Business Platform Cloud API (Meta) ---
# Obtain these from https://developers.facebook.com (WhatsApp > Getting Started).
# Leave empty to stay in simulation mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp number in international format without "+" or spaces, e.g. 919999999999
WHATSAPP_PHONE_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=veyora_webhook_verify
WHATSAPP_API_VERSION=v22.0

# --- Restaurant ---
RESTAURANT_NAME=VEYORA Demo Restaurant
TABLES=T01,T02,T03,T04,T05
TAX_RATE=0.05
CURRENCY=INR
CURRENCY_SYMBOL=₹

# --- Persistence ---
# Directory for session and order data files.
# On Render/Railway: STATE_DIR=./data  (persistent disk)
# On Vercel: STATE_DIR=/tmp            (ephemeral — sessions reset per invocation)
STATE_DIR=./data
STATE_FILE=./data/sessions.json

# --- Platform ---
# Set VERCEL=1 when deploying on Vercel serverless.
VERCEL=
