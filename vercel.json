{
  "version": 2,
  "builds": [
    { "src": "api/webhook.ts", "use": "@vercel/node" },
    { "src": "api/health.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/health.ts" },
    { "src": "/webhook", "dest": "/api/webhook.ts" },
    { "src": "/(.*)", "status": 404 }
  ]
}
